# Environment and local secrets
/.env
/.env.*
!/.env.example
*.key
/auth.json

# PHP / Composer dependencies
/vendor/

# Node dependencies and generated assets
/node_modules/
/public/build/
/public/hot
/public/storage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Laravel runtime files
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore
/storage/logs/*.log
/storage/debugbar/*
!/storage/debugbar/.gitignore
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/disks/*
/storage/framework/views/*
/storage/app/public/*
!/storage/app/public/.gitignore

# Local databases and test output
/database/*.sqlite
/database/testing.sqlite
/.phpunit.cache/
/.phpunit.result.cache
/coverage/

# IDE and editor metadata
/.idea/
/.vscode/
/.fleet/
*.code-workspace
*.sublime-project
*.sublime-workspace

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Temporary, backup, archive, and patch files
*.bak
*.backup
*.backup-*
*.orig
*.rej
*.tmp
*.temp
*~
*.zip
*.rar
*.7z
/upgrade-backup-*/
/routes/*.backup-*

# Local inspection and generated review artifacts
/REPOSITORY_CLEANUP.md
/*PORTFOLIO*REVIEW*.md
/*REMEDIATION*.md
/*VALIDATION*.txt
/*Full-Contents*.md
/*FULL-CONTENTS*.md
/SHA256SUMS.txt
